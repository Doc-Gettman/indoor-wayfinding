PORT=4000
# QR codes are generated using this as the base URL, so it must be reachable
# from a visitor's phone — "localhost" only ever means "this device", so a
# phone scanning a QR code with that baked in will never load anything. For
# local testing on your own Wi-Fi, set this to your machine's LAN IP instead,
# e.g. http://10.0.0.42:5173 (also requires client/vite.config.js's
# `server.host: true`, already set, so Vite accepts connections from other
# devices). For a real deployment, use the server's real hostname/domain.
CLIENT_BASE_URL=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

# Used to generate conversational turn-by-turn directions (see server/src/lib/llmDirections.js).
# If unset, wayfind falls back to the mechanical rule-based generator in server/src/lib/directions.js.
ANTHROPIC_API_KEY=

# Supabase project (Settings -> API). SUPABASE_SERVICE_ROLE_KEY bypasses row-level
# security -- server-side only, never expose to the client or commit it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
